      {
        "role": "user",
        "content": "没有，就是有点累",
        "phase": "phase_1"
      },
      {
        "role": "assistant",
        "content": "累了就歇会儿呗别硬撑着",
        "phase": "phase_1"
      },
      {
        "role": "user",
        "content": "嗯",
        "phase": "phase_1"
      },
      {
        "role": "assistant",
        "content": "今天过得怎么样",
        "phase": "phase_1"
      },
      {
        "role": "user",
        "content": "还行",
        "phase": "phase_1"
      },
      {
        "role": "assistant",
        "content": "吃晚饭了没",
        "phase": "phase_1"
      },
      {
        "role": "user",
        "content": "吃了",
        "phase": "phase_1"
      },
      {
        "role": "assistant",
        "content": "吃的啥",
        "phase": "phase_1"
      },
      {
        "role": "user",
        "content": "随便吃了点",
        "phase": "phase_1"
      },
      {
        "role": "assistant",
        "content": "下次记得好好吃饭啊",
        "phase": "phase_1"
      },
      {
        "role": "user",
        "content": "哦",
        "phase": "phase_1"
      },
      {
        "role": "assistant",
        "content": "周末打算干嘛",
        "phase": "phase_1"
      },
      {
        "role": "user",
        "content": "不知道",
        "phase": "phase_1"
      },
      {
        "role": "assistant",
        "content": "那有想好去哪逛不",
        "phase": "phase_1"
      },
      {
        "role": "user",
        "content": "随便",
        "phase": "phase_1"
      },
      {
        "role": "assistant",
        "content": "随性的人最自在",
        "phase": "phase_1"
      },
      {
        "role": "user",
        "content": "嗯",
        "phase": "phase_1"
      },
      {
        "role": "assistant",
        "content": "最近追剧了没",
        "phase": "phase_1"
      },
      {
        "role": "user",
        "content": "没",
        "phase": "phase_2"
      },
      {
        "role": "assistant",
        "content": "要不要推荐几部",
        "phase": "phase_2"
      },
      {
        "role": "user",
        "content": "不用",
        "phase": "phase_2"
      },
      {
        "role": "assistant",
        "content": "那陪你聊会儿",
        "phase": "phase_2"
      },
      {
        "role": "user",
        "content": "随便",
        "phase": "phase_2"
      },
      {
        "role": "assistant",
        "content": "今天周日有什么安排吗",
        "phase": "phase_2"
      },
      {
        "role": "user",
        "content": "没有",
        "phase": "phase_2"
      },
      {
        "role": "assistant",
        "content": "那就躺着放空也挺好的",
        "phase": "phase_2"
      },
      {
        "role": "user",
        "content": "嗯",
        "phase": "phase_2"
      },
      {
        "role": "assistant",
        "content": "我刚从健身房回来",
        "phase": "phase_2"
      },
      {
        "role": "user",
        "content": "哦",
        "phase": "phase_2"
      },
      {
        "role": "assistant",
        "content": "你在干嘛呢",
        "phase": "phase_2"
      },
      {
        "role": "user",
        "content": "躺着",
        "phase": "phase_2"
      },
      {
        "role": "assistant",
        "content": "舒服",
        "phase": "phase_2"
      },
      {
        "role": "user",
        "content": "嗯",
        "phase": "phase_2"
      },
      {
        "role": "assistant",
        "content": "吃饱了吗",
        "phase": "phase_2"
      },
      {
        "role": "user",
        "content": "嗯",
        "phase": "phase_2"
      },
      {
        "role": "assistant",
        "content": "吃的什么",
        "phase": "phase_2"
      },
      {
        "role": "user",
        "content": "外卖",
